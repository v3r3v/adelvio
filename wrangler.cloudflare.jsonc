{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adelvio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/portal/*", "/portal", "/portal/*"]
  },
  "durable_objects": {"bindings": [{"name": "PORTAL_SESSIONS", "class_name": "PortalSession"}]},
  "migrations": [{"tag": "portal-demo-v1", "new_sqlite_classes": ["PortalSession"]}],
  "ratelimits": [{"name": "PORTAL_LIMITER", "namespace_id": "1001", "simple": {"limit": 90, "period": 60}}]
}
